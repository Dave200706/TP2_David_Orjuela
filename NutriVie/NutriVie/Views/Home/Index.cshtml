@model IEnumerable<NutriVie.Models.Service>
@{
    ViewData["Title"] = "Home Page";
}

<section class="hero">
    <div class="wrapper">
        <div class="texte">
            <span class="subtitle">Bienvenue chez NutriVie</span>

            <h1>Mangez Sainement, Vivez Pleinement</h1>

            <p>
                Découvrez des recettes délicieuses et nutritives pour transformer
                votre alimentation et améliorer votre bien-être au quotidien.
            </p>
        </div>
        <div class="hero-image">
            <img src="images/hero-food.png" alt="Alimentation saine et colorée">
        </div>
    </div>
</section>


<section class="services" id="services">
    <div class="wrapper">

        <div class="section-header">
            <h2>Pourquoi NutriVie ?</h2>
            <p>Nous vous accompagnons vers une alimentation plus saine avec des outils adaptés à vos besoins.</p>
        </div>

        <!-- LES SERVICES -->
        <div class="cards-services">
            @foreach(var item in Model)
            {
                <div class="service-card">
                    <div class="card_media"></div>
                    <div class="card_content">
                        <h4>@item.NomDuService</h4>
                        <p>@item.Description</p>
                    </div>
                </div>
            }
           @*  <!-- Service 1 - -->
            <div class="service-card">
                <div class="card_media"></div>
                <div class="card_content">
                    <h4>Recettes Saines</h4>
                    <p>Des recettes équilibrées et faciles à préparer pour toute la famille.</p>
                </div>
            </div>

            <!-- Service 2 -->
            <div class="service-card">
                <div class="card_media"></div>
                <div class="card_content">
                    <h4>Plans Nutritionnels</h4>
                    <p>Des plans alimentaires personnalisés par nos nutritionnistes.</p>
                </div>
            </div>

            <!-- Service 3 -->
            <div class="service-card">
                <div class="card_media"></div>
                <div class="card_content">
                    <h4>Conseils d'Experts</h4>
                    <p>Des articles et guides sur la nutrition et le bien-être.</p>
                </div>
            </div> *@
        </div>
    </div>
</section>
