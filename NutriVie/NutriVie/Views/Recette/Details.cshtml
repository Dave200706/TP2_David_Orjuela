@model NutriVie.Models.Recette

@{
    ViewData["Title"] = "Details";
}

<div class="details-container">

    <h1>Details</h1>

    <h4>Recette</h4>

    <hr />

    <dl class="row">

        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Nom)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Nom)
        </dd>

        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Description)
        </dd>

        <dt class="col-sm-4">
            Durée (min)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TempsPreparation)
        </dd>

        <dt class="col-sm-4">
            Cuisson (min)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TempsCuisson)
        </dd>

        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Categorie)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Categorie.Nom)
        </dd>

        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Image)
        </dt>
        <dd class="col-sm-8">
            <img src="~/images/@Model.Image"
                 alt="@Model.Nom"
                 class="recipe-image" />
        </dd>

    </dl>

    <div class="details-links">
        <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
        <a asp-action="Index">Back to List</a>
    </div>

</div>

