@model IEnumerable<NutriVie.Models.Categorie>
@{
    ViewData["Title"] = "Index";
}
<h1>Index</h1>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Recette)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderByDescending(c=>c.Nom))
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nom)
                </td>
                <td>
                    @if (item.Recette != null)
                    {
                        @foreach(var recette in item.Recette.OrderBy(r => r.Nom))
                        {
                            <div>
                                <a asp-controller="Recette" asp-action="Edit" asp-route-id="@recette.Id">@recette.Nom (@recette.TempsPreparation min)</a>
                            </div>
                        }
                    }
                </td>
                <td>
                    @if (TempData["Erreur"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @TempData["Erreur"]
                        </div>
                    }
                
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>