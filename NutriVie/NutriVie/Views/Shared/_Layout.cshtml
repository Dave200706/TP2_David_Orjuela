<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TP2_solution</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/TP2_solution.styles.css" asp-append-version="true" />
</head>
<body>

    <header>

        <div class="wrapper">
            <div class="logo">
                <a asp-area="" asp-controller="Home" asp-action="Index">NutriVie</a>
            </div>

            <nav>
                <ul>
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Categorie">Catégories</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Recette">Recettes</a>
                    </li>
                </ul>
            </nav>

        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="wrapper">
            <nav>
                <div class="logo">
                    <a asp-area="" asp-controller="Home" asp-action="Index">NutriVie</a>
                </div>

            
                <ul>
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Categorie">Catégories</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Recette">Recettes</a>
                    </li>
                </ul>
            </nav>
            <hr>
            <div class="bottom">
                <p>© 2026 NutriVie - Tous droits réservés.</p>

                <a href="mailto:contact@nutrivie.com" class="btn btn-primary">Nous contacter</a>

                <nav class="social">
                    <ul>
                        <li>
                            <a href="https://www.facebook.com/">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.instagram.com/">
                                <i class="fab fa-instagram"></i>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.twitter.com/">
                                <i class="fab fa-twitter"></i>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.youtube.com/">
                                <i class="fab fa-youtube"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
