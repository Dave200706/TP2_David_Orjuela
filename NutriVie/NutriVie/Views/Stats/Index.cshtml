@model NutriVie.ViewModels.StatVM

@{
    ViewData["Title"] = "Statistiques de l'application";
}

<div class="container mt-4">
    

    <div class="row">
      
            
                    <p>Le nombre de recettes avec 3 aliments: <strong> @Model.NbRecettesTroisAliments</strong></p>
                    
                
        

       
    
            
                        <p> L'aliment le plus calorique: <strong>@Model.AlimentPlusCalorique.Nom</strong></p>
        
            <div>
                
                    <h5 class="mb-0">La liste des 4 recettes qui ont le plus court temps total (prépartion et cuisson) en affichant le nom et le temps total</h5>
                <div class="card-body">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Nom de la recette</th>
                                <th class="text-right">Temps total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var recette in Model.Top4RecettesCourtes)
                            {
                                <tr>
                                    <td>@recette.Nom</td>
                                    <td class="text-right font-weight-bold">@recette.TempsTotal min</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        
        <div>
                    <p> Le nombre de calories de la recette francaise la moins calorique <strong>@Model.CaloriesRecetteFrancaiseMoinsCalorique.ToString("F2")</strong></p>
        </div>
    </div>
</div>
