@model NutriVie.ViewModels.StatVM

@{
    ViewData["Title"] = "Statistiques de l'application";
}

<div class="container mt-4">
    

    <div class="row">
      
            
                    <p>Le nombre de recettes avec 3 aliments: @Model.NbRecettesTroisAliments</p>
                    
                
        

       
    
            
                        <p> L'aliment le plus calorique: @Model.AlimentPlusCalorique.CaloriesPour100g</p>
        
            <div class="card h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">⏱ Les 4 recettes les plus rapides</h5>
                </div>
                <div class="card-body">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Nom de la recette</th>
                                <th class="text-right">Temps total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var recette in Model.Top4RecettesCourtes)
                            {
                                <tr>
                                    <td>@recette.Nom</td>
                                    <td class="text-right font-weight-bold">@recette.TempsTotal min</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        
        <div class="col-md-5 mb-4">
                    <p> Le nomre de calories de la recette francaise la moins calorique @Model.CaloriesRecetteFrancaiseMoinsCalorique.ToString("F1")</p>
        </div>
    </div>
</div>
